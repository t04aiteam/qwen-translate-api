# All values optional — defaults shown. Load with `uvicorn --env-file .env`
# or export in your shell (the app does not read .env by itself).

# GGUF checkpoint to serve
# GGUF_REPO=unsloth/Qwen3.5-4B-GGUF
# GGUF_FILE=Qwen3.5-4B-Q4_K_M.gguf

# HF access token — only needed for private repos
# HF_TOKEN=

# Layers offloaded to GPU: -1 = all, 0 = CPU-only
# N_GPU_LAYERS=-1

# Context window size (tokens)
# N_CTX=8192

# Pin the service to a specific GPU
# CUDA_VISIBLE_DEVICES=0
