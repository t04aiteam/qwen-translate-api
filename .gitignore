# Virtual environments (qwen-env is ~9.9 GB — never commit)
qwen-env/
translate_env/
translate-env-c09/
venv/
.venv/
env/

# Secrets & local configuration
.env
.env.*
!.env.example
etc/aau_token
etc/*token*
etc/*key*

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Model weights & checkpoints (GGUF is downloaded/cached at runtime)
*.gguf
*.safetensors
*.bin
*.ckpt

# Logs & OS/editor noise
*.log
.DS_Store
.idea/
.vscode/
